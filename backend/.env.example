# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env
# .env GitHub'a gitmez (.gitignore'da).

# Veritabanı - Docker ortamındaki değerlerle aynı olmalı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yardimagi

# JWT imza anahtarı - KENDİ RASTGELE DEĞERİNİZİ ÜRETİN:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=buraya-rastgele-uzun-bir-metin
JWT_EXPIRE_MINUTES=720

# Admin panelinin adresi (CORS izni) - virgülle birden fazla yazılabilir
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------
# E-posta (şifre sıfırlama kodu için) - BOŞ BIRAKILABİLİR
#
# Boşsa e-posta gönderilmez, sıfırlama kodu sunucu günlüğüne yazılır.
# Geliştirme sırasında bu yeterli: terminalde kodu görüp ekrana yazarsınız.
#
# Gmail kullanacaksanız: hesabınızda iki adımlı doğrulama açık olmalı,
# sonra Google hesap ayarlarından "uygulama şifresi" üretin.
# Normal Gmail şifreniz BURADA ÇALIŞMAZ.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
