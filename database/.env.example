# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env
# .env dosyası .gitignore'dadır, GitHub'a gitmez.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yardimagi

# Bilgisayarınızda 5432 doluysa (zaten PostgreSQL kuruluysa) 5433 yapın
DB_PORT=5432

# FastAPI bağlantı adresi:
#   postgresql://postgres:postgres@localhost:5432/yardimagi
